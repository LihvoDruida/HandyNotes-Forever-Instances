package-as: Forever_Instances

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - .git
  - .github
  - .gitignore
  - .release
  - release.sh
  - check_all.sh
  - cliff.toml
  - tools
  - curseforge-icon.png
  - icon.png
  - .DS_Store
  - "*.out"
